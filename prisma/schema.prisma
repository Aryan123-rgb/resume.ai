generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// will be using clerk for storing user's data

model Project {
  id          String     @id @default(uuid())
  userId      String
  latex_code  Json 
  pdf         Bytes?
  name        String
  description String
  status      Status
  compiler    Compiler
  userData    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum Status {
  pending
  Processing 
  Completed 
  Failed 
}

enum Compiler {
  xelatex
  pdflatex
}
